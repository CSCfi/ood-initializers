<% require "/etc/ood/config/apps/dashboard/initializers/csc_configuration" %>
dashboard_layout:
  rows:
    - columns:
      - width: 12
        widgets:
          - shared_style
          - csc_pinned_apps
          - notifications
          - grafana
pinned_apps:
  - "sys/files"
  - "sys/ood-disk-quotas"
  - "sys/ood-csc-status"
  - "sys/ood-cloud-storage-conf"
  - "sys/ood-persistent-ssh"
  - "sys/ood-shell"
  - "sys/ood-vnc"
  - "sys/ood-virtualgl"
  - "sys/ood-base-jupyter"
  - "sys/ood-course-jupyter"
  - "sys/ood-julia-jupyter"
  - "sys/ood-matlab-html"
  - "sys/ood-rstudio"
  - "sys/ood-tensorboard"
  - "sys/ood-mlflow"
  - "sys/ood-vscode"
pinned_apps_menu_length: 0

brand_bg_color: "#FFFFFF"
brand_link_active_bg_color: "#D8E8EA"
navbar_type: "light"
nav_categories:
  - "Files"
  - "Jobs"
  - "Apps"
  - "Terminal"
  - "Tools"

custom_css_files:
  - '../assets/stylesheets/dashboard.css'
custom_javascript_files:
  - '../assets/scripts/csc-ui.js'
  - '../assets/scripts/form_validated.js'
  - '../assets/scripts/utils.js'
  - src: '../assets/modules/locals.js'
    type: "module"
  - src: '../assets/modules/constants.js'
    type: "module"
  - src: '../assets/modules/modals.js'
    type: "module"
  - src: '../assets/modules/utils.js'
    type: "module"
  - src: '../assets/scripts/dashboard_modals.js'
    type: "module"
  - src: '../assets/scripts/matomo.js'
    type: "module"
cancel_session_enabled: true

widget_partials_enabled: true

custom_pages:
  empty: {}
<% if ["test", "staging", "future"].include?(ENV["SLURM_OOD_ENV"]) %>
  versions:
    rows:
      - columns:
        - width: 12
          widgets:
            - shared_style
            - versions
<% end %>
<%= CSCConfiguration.custom_page("cloud_storage", app: "ood-cloud-storage-conf") -%>
