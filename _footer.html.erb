<footer class="d-flex m-0 mt-4 justify-content-between align-items-center p-4">
  <div class="mr-2">
    <%= link_to "https://openondemand.org" do %>
      <%=
        image_tag(
          "OpenOnDemand_powered_by_RGB.svg",
          class: "footer-logo",
          alt: "Powered by Open OnDemand",
          height: "40px",
        )
      %>
    <% end %>
  </div>
  <span>
    LUMI web interface: <b><%= CSCConfiguration.release_name %></b> <br> Based on OnDemand version: <%= Configuration.ood_version %>
    <br>
    <a id='cookie-policy-toggle' class='text-secondary' tabindex='0'>Cookie policy</a>
    <br>
    <a id='accessibility-statement-toggle' class='text-secondary' tabindex='0'>Accessibility statement</a>
  </span>
</footer>
